
<%= render "shared/navbar" %>

<div class="container cormorant">

  <div class="mt-3 row d-flex justify-content-center align-items-end"
       id="emdr-container">

    <div class="max-w-5xl mx-auto p-6 bg-white rounded-xl shadow-md space-y-8">

      <!-- TITRE -->
      <h1 id="emdr-title" class="mb-6">
        Thérapie ICV – Lifespan Integration
      </h1>

      <!-- INTRO -->
      <h3 class="sous-title-emdr text-center">
        L’ICV (Intégration du Cycle de la Vie) est une approche
        psychothérapeutique qui aide à intégrer les expériences
        du passé et à réduire leur impact émotionnel dans le présent.
      </h3>

      <h3 class="sous-title-emdr text-center">
        Elle s’appuie sur une ligne du temps personnelle,
        constituée de souvenirs repères, répétée au cours des séances.
      </h3>

      <p class="clarification text-center mt-3">
        Développée par Peggy Pace au début des années 2000,
        cette approche vise à favoriser l’intégration des expériences
        de vie et un meilleur ancrage dans le présent.
      </p>

      <!-- GRID 1 -->
      <div class="emdr-grid">

        <div class="emdr-card">
          <h2 class="sous-title-consult">Dans quels cas ?</h2>
          <ul>
            <li>Traumatismes et expériences douloureuses</li>
            <li>Anxiété et difficultés émotionnelles</li>
            <li>Dépression et difficultés d’estime de soi</li>
            <li>Difficultés relationnelles et d’attachement</li>
          </ul>
        </div>

        <div class="emdr-card">
          <h2 class="sous-title-consult">Comment ça fonctionne ?</h2>
          <ul>
            <li>Élaboration d’une ligne du temps personnelle</li>
            <li>Répétition de souvenirs de différentes périodes de vie</li>
            <li>Intégration progressive des expériences passées</li>
            <li>Renforcement de l’ancrage dans le présent</li>
          </ul>
        </div>

      </div>

      <!-- GRID 2 -->
      <div class="emdr-grid mt-4">

        <div class="emdr-card">
          <h2 class="sous-title-consult">Déroulement</h2>
          <ul>
            <li>Entretien initial et identification des besoins</li>
            <li>Construction d’une ligne du temps</li>
            <li>Répétition progressive des souvenirs repères</li>
            <li>Observation des ressentis et des évolutions</li>
          </ul>
        </div>

        <div class="emdr-card">
          <h2 class="sous-title-consult">Objectifs</h2>
          <ul>
            <li>Atténuer l’impact émotionnel du passé</li>
            <li>Distinguer les expériences passées des situations présentes</li>
            <li>Développer un sentiment de sécurité intérieure</li>
            <li>Faire évoluer certaines réactions automatiques</li>
          </ul>
        </div>

      </div>

